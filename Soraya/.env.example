# Copy to .env and fill in — or better, export these in your shell instead.
#
# This project never reads .env itself. Nothing here is loaded automatically:
# the Anthropic SDK reads ANTHROPIC_API_KEY from the environment, and that is
# the only path a key takes. A file called .env that gets committed by accident
# is one of the most common ways a key leaks, so this is an example only and
# .env is in .gitignore.

# For brain.provider = "claude".
# Alternatively run `ant auth login` once and set nothing at all.
ANTHROPIC_API_KEY=sk-ant-...

# For brain.provider = "openai_compat" pointed at OpenAI itself.
# Local servers (Ollama, LM Studio) ignore it.
# OPENAI_API_KEY=sk-...

# Force offline for one run, overriding settings.json.
# SORAYA_BRAIN=echo

# Move where her memories live. Defaults to ~/.soraya
# SORAYA_HOME=/path/to/somewhere
